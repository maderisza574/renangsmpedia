{
  "expo": {
    "name": "renang-smpedia",
    "slug": "renang-smpedia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "renangsmpedia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0090E0"
      },
      "package": "com.renang.smpedia"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0090E0"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3a9887da-9d7d-413e-adf8-00ab5b7c2ca1"
      }
    },
    "owner": "maderisza"
  }
}
